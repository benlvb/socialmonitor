{
  "name": "@socialmonitor/pipeline",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./adapters": "./src/adapters/registry.ts",
    "./repos": "./src/db/repos.ts",
